{
	"name": "pi-rainbow",
	"version": "0.1.0",
	"description": "Pi extension that renders CSS color values in assistant messages as terminal color swatches",
	"keywords": ["pi-package", "pi-extension", "color", "rainbow-mode"],
	"license": "MIT",
	"type": "module",
	"files": ["src", "README.md", "LICENSE"],
	"pi": {
		"extensions": ["./src/pi-rainbow.ts"]
	},
	"scripts": {
		"check": "tsc --noEmit",
		"test": "vitest --run"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "1.2.0",
		"@earendil-works/pi-tui": "1.2.0",
		"@types/node": "^22.0.0",
		"typescript": "^5.7.0",
		"vitest": "^3.0.0"
	}
}
